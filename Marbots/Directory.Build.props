<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1720;CA1002;CA2227;CA1056;CA1054;CA1819;CA1031;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1304;CA1311;CA2007;CA1822;CA1849;CA1860;CA1805;CA1708;CA5394;CA1859;CA1863;CA2234;CA1835;CA1869;CA1812;CA1515;CA1034;CA1724;CA2000;CA1873;CA1806;CA1508;CA1823;CA1865;CA1866;CA1847;CA2016;CA1845;CA1854;CA1851;CA1050;CA1707</NoWarn>
    <Version>0.1.1</Version>
    <Authors>Gravicode Studios (led by Kang Fadhil)</Authors>
    <Company>Gravicode Studios</Company>
    <Product>Marbots</Product>
    <Copyright>Copyright (c) 2026 Gravicode Studios</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Dev</RepositoryUrl>
    <PackageTags>ai;agents;multi-agent;llm;mcp;a2a;orchestration</PackageTags>
  </PropertyGroup>
</Project>
