<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WarungDesk" x:Class="WarungDesk.MainWindow" Title="Senja · Kasir" Width="780" Height="560" Background="#F5F1E8">
 <Grid RowDefinitions="Auto,*,Auto" Margin="36"><StackPanel Grid.Row="0" Margin="0,0,0,24"><TextBlock Text="SENJA •" Foreground="#CF6B3D" FontSize="14" FontWeight="Bold"/><TextBlock Text="Menu hari ini" Foreground="#202923" FontSize="36" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Warung Kopi Senja  /  kasir" Foreground="#727A6F" FontSize="13"/></StackPanel>
 <Grid Grid.Row="1" ColumnDefinitions="*,250" ColumnSpacing="28"><Border Grid.Column="0" Background="#F8F5ED" BorderBrush="#D7D9C9" BorderThickness="1" Padding="18"><ListBox x:Name="MenuList" x:DataType="local:Drink" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="local:Drink"><Grid ColumnDefinitions="40,*,Auto" Margin="0,8"><TextBlock Text="{Binding Icon}" Foreground="#CF6B3D" FontSize="22"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="#202923" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#727A6F" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding PriceText}" Foreground="#385545" FontWeight="Bold" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
 <Border Grid.Column="1" Background="#385545" Padding="22"><StackPanel><TextBlock Text="PESANAN" Foreground="#DCE7B3" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="CountText" Text="0 minuman" Foreground="#F5F1E8" FontSize="24" Margin="0,12,0,22"/><Separator Background="#71806D"/><TextBlock Text="TOTAL" Foreground="#C5D0B8" FontSize="11" Margin="0,25,0,5"/><TextBlock x:Name="TotalText" Text="Rp0" Foreground="#F5F1E8" FontSize="32" FontWeight="SemiBold"/><Button Content="Mulai lagi" Click="OnClear" Background="#DCE7B3" Foreground="#202923" BorderThickness="0" Padding="12" Margin="0,28,0,0"/></StackPanel></Border></Grid>
 <TextBlock Grid.Row="2" Text="Pilih beberapa menu dengan Ctrl / Cmd untuk menghitung total." Foreground="#727A6F" FontSize="12" Margin="0,24,0,0"/></Grid></Window>