@page "/settings"
@inject MobileSession Session

<h1 class="title">Settings</h1>
<p class="sub">Connect to your Marbots server. On a phone, use your computer's LAN address (for example http://192.168.1.10:5170) and start the server with <code>--urls http://0.0.0.0:5170</code>.</p>

<div class="card form">
    <label>Server URL<input @bind="_url" inputmode="url" autocapitalize="off" placeholder="http://192.168.1.10:5170" /></label>
    <label>API key <small class="muted">(stored in the device's secure storage)</small><input @bind="_key" type="password" autocomplete="off" /></label>
    <button class="primary" disabled="@_busy" @onclick="Connect">@(_busy ? "Connecting…" : "Connect")</button>
    @if (_message is not null) { <p class="@(_ok ? "ok-text" : "error")">@_message</p> }
</div>

<div class="card form">
    <label class="toggle"><input type="checkbox" checked="@Session.NotificationsEnabled" @onchange="ToggleNotify" /> Notify me about approvals and finished tasks</label>
</div>

<div class="card form">
    <strong>When the app is closed</strong>
    <p class="small muted">Get approvals and finished tasks as push notifications through <a href="https://ntfy.sh" target="_blank">ntfy</a> (free, no account). This phone gets its own private topic; install the ntfy app and subscribe to it.</p>
    @if (_push is { } d)
    {
        <p class="small">Topic <code>@d.Token</code> · registered</p>
        <a class="primary button" href="@($"{_ntfyServer}/{d.Token}")" target="_blank">Open in ntfy</a>
        <button disabled="@_busy" @onclick="RemovePush">Turn off</button>
        <button disabled="@_busy" @onclick="TestPush">Send a test</button>
    }
    else
    {
        <button class="primary" disabled="@(_busy || !Session.IsConnected)" @onclick="RegisterPush">Turn on push</button>
    }
    @if (_pushMessage is not null) { <p class="small">@_pushMessage</p> }
</div>

<div class="card small muted">
    @if (Session.Server is { } s) { <p>@s.Product @s.Version · @s.CreditsEn</p> }
    <p>Marbots mobile · Created by Gravicode Studios, led by Kang Fadhil · Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil</p>
</div>

@code {
    private string _url = "";
    private string? _key;
    private bool _busy;
    private bool _ok;
    private string? _message;
    private PushDevice? _push;
    private string _ntfyServer = "https://ntfy.sh";
    private string? _pushMessage;
    private const string TopicKey = "marbots.ntfy-topic";

    protected override async Task OnInitializedAsync()
    {
        _url = Session.Url;
        _key = await Session.StoredApiKeyAsync();
        if (Session.IsConnected) (_ok, _message) = (true, $"Connected to {Session.Url}");
        else if (Session.Error is { } err) _message = err;
        await LoadPushAsync();
    }

    private async Task LoadPushAsync()
    {
        if (Session.Client is not { } c || !Session.IsConnected) return;
        try
        {
            _ntfyServer = (await c.Push.ConfigAsync()).NtfyServer;
            var topic = Preferences.Default.Get<string?>(TopicKey, null);
            _push = topic is null ? null : (await c.Push.ListAsync()).FirstOrDefault(d => d.Platform == PushPlatforms.Ntfy && d.Token == topic);
        }
        catch (Exception ex) when (ex is HttpRequestException or MarbotsApiException) { _pushMessage = ex.Message; }
    }

    private async Task RegisterPush()
    {
        if (Session.Client is not { } c) return;
        _busy = true;
        try
        {
            // A long random topic: on public ntfy servers, anyone who knows the topic can read it.
            var topic = Preferences.Default.Get<string?>(TopicKey, null) ?? "marbots-" + Convert.ToHexStringLower(System.Security.Cryptography.RandomNumberGenerator.GetBytes(12));
            Preferences.Default.Set(TopicKey, topic);
            _push = await c.Push.RegisterAsync(PushPlatforms.Ntfy, topic, DeviceInfo.Name);
            _pushMessage = "Push is on. Subscribe to the topic in the ntfy app.";
        }
        catch (Exception ex) when (ex is HttpRequestException or MarbotsApiException) { _pushMessage = ex.Message; }
        _busy = false;
    }

    private async Task RemovePush()
    {
        if (Session.Client is not { } c || _push is null) return;
        _busy = true;
        try { await c.Push.RemoveAsync(_push.Id); _push = null; _pushMessage = "Push is off."; }
        catch (Exception ex) when (ex is HttpRequestException or MarbotsApiException) { _pushMessage = ex.Message; }
        _busy = false;
    }

    private async Task TestPush()
    {
        if (Session.Client is not { } c) return;
        _busy = true;
        try { var r = await c.Push.TestAsync(); _pushMessage = r.Failed == 0 ? $"Sent to {r.Sent} device(s)." : string.Join("; ", r.Errors); }
        catch (Exception ex) when (ex is HttpRequestException or MarbotsApiException) { _pushMessage = ex.Message; }
        _busy = false;
    }

    private async Task Connect()
    {
        _busy = true;
        _ok = await Session.ConnectAsync(_url, _key);
        _message = _ok ? $"Connected to {Session.Url} · {Session.Bots.Count} bots" : $"Could not connect: {Session.Error}";
        _busy = false;
    }

    private async Task ToggleNotify(ChangeEventArgs e)
    {
        Session.NotificationsEnabled = e.Value is true;
        if (Session.NotificationsEnabled) await Session.StartNotificationsAsync();
    }
}
