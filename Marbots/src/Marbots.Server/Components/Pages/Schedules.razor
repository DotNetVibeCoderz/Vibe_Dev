@page "/schedules"
@inherits LiveComponent
@inject SchedulerService Scheduler
@inject BotRegistry Registry
@inject NavigationManager Nav
@inject TriggerService Triggers
@inject LocalSecretProvider Secrets

<PageTitle>@T["nav.schedules"] · Marbots</PageTitle>
<div class="page">
    <div class="page-head">
        <div>
            <h1>@T["nav.schedules"]</h1>
            <p>Recurring and one-off jobs. Each run sends the prompt to a bot in its own thread. You can also ask Boss Man, e.g. "every weekday at 07:30 summarise my inbox notes".</p>
        </div>
    </div>
    @if (_message is not null) { <div class="@(_isError ? "error-box" : "ok-box")">@_message</div> }

    <div class="panel panel-pad" style="margin-bottom:18px">
        <h2 style="margin-bottom:12px">New schedule</h2>
        <div class="split">
            <label class="field"><span>Name</span><input class="input" @bind="_job.Name" placeholder="Weekly KPI summary" /></label>
            <label class="field"><span>Bot</span>
                <select class="select" @bind="_job.BotId">@foreach (var b in _bots) { <option value="@b.Id">@b.Name</option> }</select>
            </label>
            <label class="field"><span>Cron <small>(minute hour day month weekday)</small></span><input class="input" @bind="_job.Cron" placeholder="0 8 * * 1" />
                <small>@CronHint</small></label>
            <label class="field"><span>…or run once at</span><input class="input" type="datetime-local" @bind="_runAt" /></label>
            <label class="field"><span>Time zone</span><input class="input" @bind="_job.TimeZone" placeholder="SE Asia Standard Time / Asia/Jakarta / UTC" /></label>
        </div>
        <label class="field"><span>Prompt</span><textarea class="textarea" rows="3" @bind="_job.Prompt"></textarea></label>
        <button class="btn primary" @onclick="Save">Save schedule</button>
    </div>

    <div class="panel">
        <table class="table">
            <thead><tr><th>Name</th><th>Bot</th><th>When</th><th>Next run</th><th>Last run</th><th></th></tr></thead>
            <tbody>
                @foreach (var j in _jobs)
                {
                    <tr>
                        <td><b>@j.Name</b><div class="muted small-text">@AgentRuntime.Preview(j.Prompt, 90)</div></td>
                        <td>@(_bots.FirstOrDefault(b => b.Id == j.BotId)?.Name ?? j.BotId)</td>
                        <td><code>@(string.IsNullOrEmpty(j.Cron) ? "once" : j.Cron)</code> <span class="muted small-text">@j.TimeZone</span></td>
                        <td class="small-text">@(j.Enabled ? j.NextRunAt?.ToLocalTime().ToString("ddd dd MMM HH:mm") ?? "—" : "disabled")</td>
                        <td class="small-text">@(j.LastRunAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "never") @if (j.ThreadId is not null) { <a href="/chat/@j.ThreadId">thread</a> }</td>
                        <td class="row">
                            <button class="btn small" @onclick="() => RunNow(j)">Run now</button>
                            <button class="btn small" @onclick="() => Toggle(j)">@(j.Enabled ? T["pause"] : T["resume"])</button>
                            <button class="btn small danger" @onclick="() => Delete(j)">@T["delete"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_jobs.Count == 0) { <p class="muted panel-pad">No schedules yet.</p> }
    </div>

    <h2 style="margin:28px 0 12px">Triggers</h2>
    <p class="muted small-text">Start a bot from a webhook call (Zapier, GitHub, n8n, cron jobs elsewhere…) or when something happens in Marbots. Placeholders: <code>{{payload}}</code>, <code>{{bot}}</code>, <code>{{result}}</code>, <code>{{task}}</code>.</p>
    <div class="panel panel-pad" style="margin-bottom:16px">
        <div class="split">
            <label class="field"><span>Name</span><input class="input" @bind="_trg.Name" placeholder="New GitHub issue" /></label>
            <label class="field"><span>Kind</span>
                <select class="select" @bind="_trg.Kind"><option value="@TriggerKinds.Webhook">Webhook</option><option value="@TriggerKinds.Event">Event in Marbots</option></select>
            </label>
            <label class="field"><span>Bot</span>
                <select class="select" @bind="_trg.BotId">@foreach (var b in _bots) { <option value="@b.Id">@b.Name</option> }</select>
            </label>
            @if (_trg.Kind == TriggerKinds.Webhook)
            {
                <label class="field"><span>Secret <small>(callers send X-Marbots-Secret or an HMAC X-Marbots-Signature)</small></span><input class="input" type="password" @bind="_trgSecret" autocomplete="off" /></label>
            }
            else
            {
                <label class="field"><span>When this bot finishes a task</span>
                    <select class="select" @bind="_trg.SourceBotId"><option value="">any bot</option>@foreach (var b in _bots) { <option value="@b.Id">@b.Name</option> }</select>
                </label>
            }
        </div>
        <label class="field"><span>Prompt template</span><textarea class="textarea" rows="3" @bind="_trg.PromptTemplate" placeholder="Triage this GitHub issue and propose next steps: {{payload}}"></textarea></label>
        <button class="btn primary" @onclick="SaveTrigger">Save trigger</button>
    </div>
    <div class="panel">
        <table class="table">
            <thead><tr><th>Trigger</th><th>Bot</th><th>Kind</th><th>Fired</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in _triggers)
                {
                    <tr>
                        <td><b>@t.Name</b><div class="muted small-text">@AgentRuntime.Preview(t.PromptTemplate, 90)</div>
                            @if (t.Kind == TriggerKinds.Webhook) { <code class="small-text">POST @(Nav.BaseUri)api/v1/hooks/@t.Id</code> }</td>
                        <td>@(_bots.FirstOrDefault(b => b.Id == t.BotId)?.Name ?? t.BotId)</td>
                        <td>@(t.Kind == TriggerKinds.Webhook ? "webhook" : $"after {(string.IsNullOrEmpty(t.SourceBotId) ? "any bot" : t.SourceBotId)} completes")</td>
                        <td class="small-text">@t.FireCount× @(t.LastFiredAt?.ToLocalTime().ToString("dd MMM HH:mm")) @if (t.ThreadId is not null) { <a href="/chat/@t.ThreadId">thread</a> }</td>
                        <td><button class="btn small danger" @onclick="() => DeleteTrigger(t)">@T["delete"]</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_triggers.Count == 0) { <p class="muted panel-pad">No triggers yet.</p> }
    </div>
</div>

@code {
    private IReadOnlyList<ScheduleJob> _jobs = [];
    private IReadOnlyList<BotDefinition> _bots = [];
    private ScheduleJob _job = new() { TimeZone = "UTC" };
    private DateTime? _runAt;
    private string? _message;
    private bool _isError;

    private string CronHint
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_job.Cron)) return "Examples: 0 8 * * 1 (Mondays 08:00), */30 9-17 * * 1-5 (every 30 min on workdays)";
            if (!CronExpression.TryParse(_job.Cron, out var c)) return "Invalid cron expression.";
            try
            {
                var next = c!.Next(DateTimeOffset.UtcNow, SchedulerService.Zone(_job.TimeZone));
                return next is null ? "Never fires." : $"Next: {next:ddd dd MMM yyyy HH:mm} ({_job.TimeZone})";
            }
            catch (ArgumentException ex) { return ex.Message; }
        }
    }

    private IReadOnlyList<TriggerConfig> _triggers = [];
    private TriggerConfig _trg = new() { BotId = WellKnown.BossManId };
    private string _trgSecret = "";

    private async Task SaveTrigger()
    {
        try
        {
            if (string.IsNullOrEmpty(_trg.Id)) _trg.Id = Ids.New("trg");
            if (_trg.Kind == TriggerKinds.Webhook && _trgSecret.Length > 0)
            {
                _trg.SecretRef = $"trigger:{_trg.Id}";
                Secrets.Set(_trg.SecretRef, _trgSecret);
            }
            if (_trg.Kind == TriggerKinds.Event && string.IsNullOrEmpty(_trg.SourceBotId)) _trg.SourceBotId = null;
            await Triggers.SaveAsync(_trg);
            _message = $"Saved trigger '{_trg.Name}'."; _isError = false;
            _trg = new() { BotId = WellKnown.BossManId };
            _trgSecret = "";
        }
        catch (ArgumentException ex) { _message = ex.Message; _isError = true; }
        _triggers = await Triggers.ListAsync();
    }

    private async Task DeleteTrigger(TriggerConfig t)
    {
        await Triggers.DeleteAsync(t.Id);
        _triggers = await Triggers.ListAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _triggers = await Triggers.ListAsync();
        _bots = await Registry.ActiveAsync();
        _job.BotId = WellKnown.BossManId;
        _jobs = await Scheduler.ListAsync();
    }

    protected override bool Accept(AgentEvent e) => e.Type is EventTypes.ScheduleTriggered or EventTypes.TriggerFired;

    protected override async Task RefreshAsync(IReadOnlyList<AgentEvent> events)
    {
        _jobs = await Scheduler.ListAsync();
        _triggers = await Triggers.ListAsync();
    }

    private async Task Save()
    {
        try
        {
            if (_runAt is { } at) _job.RunAt = new DateTimeOffset(at, TimeZoneInfo.Local.GetUtcOffset(at));
            await Scheduler.SaveAsync(_job, default);
            _message = $"Saved '{_job.Name}'."; _isError = false;
            _job = new() { TimeZone = "UTC", BotId = WellKnown.BossManId };
            _runAt = null;
        }
        catch (ArgumentException ex) { _message = ex.Message; _isError = true; }
        _jobs = await Scheduler.ListAsync();
    }

    private async Task RunNow(ScheduleJob j)
    {
        try
        {
            var task = await Scheduler.RunNowAsync(j.Id, default);
            Nav.NavigateTo($"/chat/{task.ThreadId}");
        }
        catch (Exception ex) when (ex is ArgumentException or BotValidationException) { _message = ex.Message; _isError = true; }
    }

    private async Task Toggle(ScheduleJob j)
    {
        j.Enabled = !j.Enabled;
        await Scheduler.SaveAsync(j, default);
        _jobs = await Scheduler.ListAsync();
    }

    private async Task Delete(ScheduleJob j)
    {
        await Scheduler.DeleteAsync(j.Id);
        _jobs = await Scheduler.ListAsync();
    }
}
