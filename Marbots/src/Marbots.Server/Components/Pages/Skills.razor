@page "/skills"
@inherits LiveComponent
@inject SkillRegistry Registry
@inject SkillEvaluator Evaluator
@inject ApprovalService Approvals

<PageTitle>@T["nav.skills"] · Marbots</PageTitle>
<div class="page">
    <div class="page-head">
        <div>
            <h1>Skills gallery</h1>
            <p>Skills are <code>SKILL.md</code> packages (compatible with Claude/Agent Skills and OpenClaw). Bots see only the name and description until they load a skill, which keeps context small.</p>
        </div>
        <button class="btn primary" @onclick="() => _showCreate = !_showCreate"><Icon Name="plus" /> New skill</button>
    </div>
    @if (_message is not null) { <div class="@(_isError ? "error-box" : "ok-box")">@_message</div> }

    <div class="panel panel-pad" style="margin-bottom:16px">
        <h3 style="margin-bottom:8px">Install from a folder or git repository</h3>
        <div class="row">
            <input class="input grow" placeholder="https://github.com/org/skills-repo.git or C:\path\to\skills" @bind="_source" />
            <button class="btn" @onclick="Install" disabled="@_busy">@(_busy ? "Installing…" : "Install")</button>
        </div>
        <p class="small-text muted" style="margin:8px 0 0">Every SKILL.md found is copied into <code>data/skills</code>. Review scripts before giving a skill to bots with shell access.</p>
    </div>

    @if (_showCreate)
    {
        <div class="panel panel-pad" style="margin-bottom:16px">
            <div class="split">
                <label class="field"><span>Name</span><input class="input" @bind="_newName" placeholder="weekly-report" /></label>
                <label class="field"><span>Description</span><input class="input" @bind="_newDesc" placeholder="When to use this skill" /></label>
            </div>
            <label class="field"><span>Instructions (Markdown)</span><textarea class="textarea" rows="10" @bind="_newBody"></textarea></label>
            <button class="btn primary" @onclick="Create">Create skill</button>
        </div>
    }

    @if (_pending.Count > 0)
    {
        <h2 style="margin:8px 0 12px">Waiting for review (auto-learn)</h2>
        @foreach (var s in _pending)
        {
            <div class="approval-card" style="max-width:none">
                <b>@s.Name</b> — @s.Description
                @if (Eval(s) is { } ev)
                {
                    <div class="small-text" style="margin-top:6px"><Verdict Evaluation="ev" />@(s.Author is { } a ? $" · on trial with {a}" : "")</div>
                }
                <details style="margin-top:6px"><summary class="small-text">Show draft</summary><pre>@File.ReadAllText(Path.Combine(s.Path, "SKILL.md"))</pre></details>
                <div class="row" style="margin-top:8px">
                    <button class="btn small primary" @onclick="() => Approve(s)">Publish skill</button>
                    <button class="btn small danger" @onclick="() => Reject(s)">Discard</button>
                </div>
            </div>
        }
    }

    <div class="panel panel-pad row" style="margin-bottom:16px;justify-content:space-between">
        <div>
            <b>Learning evaluation</b>
            <div class="small-text muted">Every task that loads a skill counts as a success or failure for that skill version. Drafts from auto-learn are trialled by the bot that wrote them; you decide when to publish. Replacing a skill keeps the old version for rollback.</div>
        </div>
        <label class="row small-text" style="gap:8px;white-space:nowrap"><input type="checkbox" checked="@_autoRollback" @onchange="ToggleAutoRollback" /> Roll back automatically</label>
    </div>

    <div class="panel">
        <table class="table">
            <thead><tr><th>Skill</th><th>Trust</th><th>Needs</th><th>Version</th><th>Learning evaluation</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in _installed)
                {
                    <tr>
                        <td><b>@s.Name</b><div class="muted small-text">@s.Description</div></td>
                        <td><span class="chip">@s.Trust</span></td>
                        <td class="small-text">@(s.NeedsShell ? "shell " : "")@(s.NeedsNetwork ? "network " : "")@(s.HasScripts ? "scripts" : "")@(!s.NeedsShell && !s.NeedsNetwork && !s.HasScripts ? "—" : "")</td>
                        <td class="small-text">@s.Version</td>
                        <td class="small-text">@if (Eval(s) is { } ev) { <Verdict Evaluation="ev" /> }</td>
                        <td class="row" style="gap:6px;flex-wrap:nowrap">
                            @if (Eval(s) is { CanRollback: true } rb)
                            {
                                <button class="btn small @(rb.Verdict == SkillVerdict.RollbackRecommended ? "primary" : "")" title="Restore version @rb.PreviousVersion" @onclick="() => Rollback(s)">Roll back to @rb.PreviousVersion</button>
                            }
                            @if (s.Source == "installed") { <button class="btn small danger" @onclick="() => Uninstall(s)">Remove</button> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<SkillInfo> _installed = [];
    private List<SkillInfo> _pending = [];
    private string _source = "", _newName = "", _newDesc = "", _newBody = "";
    private string? _message;
    private bool _isError, _busy, _showCreate;

    private Dictionary<string, SkillEvaluation> _evals = [];
    private bool _autoRollback;

    protected override async Task OnParametersSetAsync()
    {
        _autoRollback = (await Approvals.GetSettingsAsync()).AutoRollbackSkills;
        await LoadAsync();
    }

    private void Load() => _ = InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _installed = Registry.All.Where(s => !s.Pending).ToList();
        _pending = Registry.All.Where(s => s.Pending).ToList();
        _evals = (await Evaluator.EvaluateAllAsync()).GroupBy(e => (e.Pending ? "p:" : "") + e.Name.ToLowerInvariant()).ToDictionary(g => g.Key, g => g.First());
        StateHasChanged();
    }

    private SkillEvaluation? Eval(SkillInfo s) => _evals.GetValueOrDefault((s.Pending ? "p:" : "") + s.Name.ToLowerInvariant());

    protected override bool Accept(AgentEvent e) => e.Type is EventTypes.AutoLearnCandidateCreated or EventTypes.SkillLoaded or EventTypes.SkillRolledBack
        || e.Type == EventTypes.TaskStateChanged && e.Data is "Completed" or "Failed";

    protected override Task RefreshAsync(IReadOnlyList<AgentEvent> events) => LoadAsync();

    private async Task Rollback(SkillInfo s)
    {
        var v = await Evaluator.RollbackAsync(s.Name, "web");
        (_message, _isError) = v is null ? ($"No earlier version of '{s.Name}'.", true) : ($"Rolled '{s.Name}' back to {v}.", false);
        await LoadAsync();
    }

    private async Task ToggleAutoRollback(ChangeEventArgs e)
    {
        _autoRollback = e.Value is true;
        await Approvals.SetAutoRollbackSkillsAsync(_autoRollback, "web");
    }

    private async Task Install()
    {
        if (string.IsNullOrWhiteSpace(_source)) return;
        _busy = true;
        try
        {
            var list = await Registry.InstallAsync(_source.Trim(), default);
            _message = list.Count == 0 ? "No SKILL.md files were found." : $"Installed {list.Count}: {string.Join(", ", list.Select(s => s.Name))}";
            _isError = list.Count == 0;
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException or System.ComponentModel.Win32Exception)
        {
            _message = ex.Message; _isError = true;
        }
        _busy = false;
        Load();
    }

    private async Task Create()
    {
        try
        {
            var s = await Registry.CreateAsync(_newName, _newDesc, _newBody, false, default);
            _message = $"Created skill '{s.Name}'."; _isError = false; _showCreate = false;
        }
        catch (ArgumentException ex) { _message = ex.Message; _isError = true; }
        Load();
    }

    private void Approve(SkillInfo s) { Registry.ApprovePending(s.Name); _message = $"Published '{s.Name}'."; _isError = false; Load(); }
    private void Reject(SkillInfo s) { Registry.RejectPending(s.Name); Load(); }
    private void Uninstall(SkillInfo s) { Registry.Uninstall(s.Name); Load(); }
}
