<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Marbots.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0F1222" />
    <SolidColorBrush x:Key="Surface" Color="#171B30" />
    <SolidColorBrush x:Key="Surface2" Color="#20253F" />
    <SolidColorBrush x:Key="Line" Color="#2B3155" />
    <SolidColorBrush x:Key="Ink" Color="#E9ECFA" />
    <SolidColorBrush x:Key="Muted" Color="#959CC2" />
    <SolidColorBrush x:Key="Indigo" Color="#6D7BFF" />
    <SolidColorBrush x:Key="Danger" Color="#FF5C6C" />
    <SolidColorBrush x:Key="Ok" Color="#3DD68C" />
    <SolidColorBrush x:Key="Warn" Color="#FFB547" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource Bg}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="#D9171B30" />
      <Setter Property="BorderBrush" Value="#552B3155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="BoxShadow" Value="0 10 30 0 #55000000" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#E6171B30" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Indigo}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#8390FF" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#CC20253F" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="58" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Button.nav PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Button.nav.active PathIcon">
      <Setter Property="Foreground" Value="{StaticResource Indigo}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </Application.Styles>
</Application>
