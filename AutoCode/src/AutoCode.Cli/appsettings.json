{
  "$comment": "Auto Code default settings — Gravicode Studios (Kang Fadhil). Overridden by ~/.autocode/settings.json, then <workspace>/.autocode/settings.json, then settings.local.json, then AUTOCODE_ environment variables.",

  "AutoCode": {
    "activeProvider": "",

    "providers": {},

    "permissionMode": "ask",
    "permissions": {
      "allow": [
        "Read",
        "Glob",
        "Grep",
        "List",
        "TodoWrite"
      ],
      "deny": [
        "Read(**/.env)",
        "Read(**/.env.*)",
        "Write(**/.env)",
        "Bash(rm -rf:*)",
        "Bash(git push --force:*)"
      ]
    },

    "maxTurnIterations": 100,
    "compactionThreshold": 0.82,
    "persistSessions": true,
    "showCost": true,
    "showThinking": true,
    "enableSemanticIndex": false,
    "bashTimeoutMs": 120000,
    "language": "en",

    "verifyCommands": [],
    "contextFiles": [],
    "skillDirectories": [],
    "plugins": [],
    "disabledTools": [],

    "agents": {},
    "teams": {},
    "hooks": {},
    "mcpServers": {}
  }
}
