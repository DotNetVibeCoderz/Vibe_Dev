<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoCode.Providers.Onnx</RootNamespace>
    <Description>
      Auto Code offline embeddings: runs a local ONNX sentence-transformer with no server, no network
      and no API key. Kept in its own project because ONNX Runtime ships a native library that most
      installations never need.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCode.Core\AutoCode.Core.csproj" />
  </ItemGroup>

</Project>
